{
  "schema": "ravi.app/v1",
  "id": "workspace-hub",
  "name": "Ravi Workspace",
  "version": "0.1.0-alpha.7",
  "description": "Workspace pessoal instalado no Ravi do usuário.",
  "interfaces": {
    "cli": {
      "command": "ravi workspace-hub",
      "json": true,
      "health": "ravi workspace-hub check --json"
    },
    "ui": {
      "routes": [
        {
          "id": "main",
          "path": "/apps/workspace-hub",
          "label": "Ravi Workspace",
          "icon": "app-window",
          "view": "main"
        }
      ],
      "views": [
        {
          "id": "main",
          "type": "dashboard",
          "title": "Ravi Workspace",
          "density": "compact",
          "query": {
            "operation": "workspace-hub.status"
          },
          "actions": [
            {
              "id": "check",
              "label": "Check",
              "icon": "shield-check",
              "operation": "workspace-hub.check",
              "placement": "toolbar"
            }
          ]
        }
      ]
    }
  },
  "operations": {
    "workspace-hub.help": {
      "interface": "builtin",
      "handler": "apps.help",
      "mutating": false
    },
    "workspace-hub.show": {
      "interface": "builtin",
      "handler": "apps.manifest.show",
      "mutating": false
    },
    "workspace-hub.check": {
      "interface": "builtin",
      "handler": "apps.manifest.check",
      "mutating": false
    },
    "workspace-hub.status": {
      "interface": "cli",
      "command": "bun ./cli.mjs status --json {args}",
      "mutating": false,
      "permission": "workspace-hub:read"
    },
    "workspace-hub.init": {
      "interface": "cli",
      "command": "bun ./cli.mjs init --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.build": {
      "interface": "cli",
      "command": "bun ./cli.mjs build --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.discover": {
      "interface": "cli",
      "command": "bun ./cli.mjs discover --json {args}",
      "mutating": false,
      "permission": "workspace-hub:read"
    },
    "workspace-hub.collect": {
      "interface": "cli",
      "command": "bun ./cli.mjs collect --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.setup": {
      "interface": "cli",
      "command": "bun ./cli.mjs setup --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.prepare-operation": {
      "interface": "cli",
      "command": "bun ./cli.mjs prepare-operation --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.operation-status": {
      "interface": "cli",
      "command": "bun ./cli.mjs operation-status --json {args}",
      "mutating": false,
      "permission": "workspace-hub:read"
    },
    "workspace-hub.refresh": {
      "interface": "cli",
      "command": "bun ./cli.mjs refresh --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.schedule": {
      "interface": "cli",
      "command": "bun ./cli.mjs schedule --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    },
    "workspace-hub.open": {
      "interface": "cli",
      "command": "bun ./cli.mjs open --json {args}",
      "mutating": true,
      "permission": "workspace-hub:write"
    }
  },
  "permissions": {
    "required": [
      "workspace-hub:read"
    ],
    "optional": [],
    "mutating": [
      "workspace-hub:write"
    ]
  },
  "storage": {
    "sqlite": [],
    "files": [
      {
        "path": "<config-file>",
        "kind": "state",
        "retention": "durable"
      },
      {
        "path": "<config-file>.snapshot.json",
        "kind": "cache",
        "retention": "cache"
      },
      {
        "path": "<operation-root>/<installation-id>",
        "kind": "state",
        "retention": "durable"
      }
    ]
  },
  "artifacts": [],
  "events": {
    "emits": [],
    "consumes": []
  },
  "skills": [],
  "health": {
    "checks": [
      {
        "type": "builtin",
        "handler": "apps.manifest.check"
      }
    ]
  },
  "versioning": {
    "compatibility": "semver",
    "migrations": []
  }
}
